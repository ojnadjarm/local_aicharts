{{!
    @template local_aicharts/result_card_body

    The body of a chart card: the result, or the reason there is none.

    Context variables required for this template:
    * id - The chart id.
    * canmanage - Whether the user may run the chart now.
    * paused - Whether the chart is paused.
    * failed - Whether the run failed.
    * errormessage - Why the run failed.
    * norows - Whether the run returned no rows.
    * notrunyet - Whether a scheduled chart has no stored result.
    * notloaded - Whether a live chart has no stored result and was not run on load.
    * runagain - Whether the shown result can be run again and stored.
    * runlabel - Label of that button: Run again, or Run now when nothing was ever stored.
    * queued - Whether a run of the chart waits for cron.
    * nextrunformatted - When the chart runs next.
    * refreshurl - Link reloading the dashboard.
    * body - The rendered chart or result table.

    Example context (json):
    {
        "id": 1,
        "canmanage": true,
        "paused": false,
        "notloaded": true,
        "failed": false,
        "body": ""
    }
}}
{{#paused}}
    <div class="local-aicharts-statebox d-flex gap-2" role="status">
        <i class="icon fa fa-pause mt-1" aria-hidden="true"></i>
        <div>{{#str}}pausedstate, local_aicharts{{/str}}</div>
    </div>
{{/paused}}
{{#notloaded}}
    <div class="local-aicharts-statebox d-flex gap-2" role="status">
        <i class="icon fa fa-circle-info mt-1" aria-hidden="true"></i>
        <div>{{#str}}notloaded, local_aicharts{{/str}}</div>
    </div>
{{/notloaded}}
{{#notrunyet}}
    <div class="local-aicharts-statebox d-flex gap-2" role="status">
        <i class="icon fa fa-clock mt-1" aria-hidden="true"></i>
        <div>
            {{#queued}}
                {{#str}}queuedstate, local_aicharts{{/str}}
                <a href="{{refreshurl}}">{{#str}}refresh, local_aicharts{{/str}}</a>
            {{/queued}}
            {{^queued}}
                {{#str}}notrunyet, local_aicharts{{/str}}
                <div>{{nextrunformatted}}</div>
            {{/queued}}
        </div>
    </div>
    {{#canmanage}}
        <button type="button" class="btn btn-secondary mt-auto align-self-start" data-action="runnow" data-id="{{id}}" {{#queued}}disabled{{/queued}}>
            <i class="icon fa fa-play" aria-hidden="true"></i>{{#str}}runnow, local_aicharts{{/str}}
        </button>
    {{/canmanage}}
{{/notrunyet}}
{{#failed}}
    <div class="local-aicharts-statebox d-flex gap-2" role="status">
        <i class="icon fa fa-triangle-exclamation mt-1" aria-hidden="true"></i>
        <div>
            {{#str}}chartfailed, local_aicharts{{/str}}
            <details class="mt-1">
                <summary class="small">{{#str}}errordetails, local_aicharts{{/str}}</summary>
                <p class="small text-muted mb-0 mt-1">{{errormessage}}</p>
            </details>
        </div>
    </div>
{{/failed}}
{{#norows}}
    <div class="local-aicharts-statebox d-flex gap-2" role="status">
        <i class="icon fa fa-circle-info mt-1" aria-hidden="true"></i>
        <div>{{#str}}norows, local_aicharts{{/str}}</div>
    </div>
{{/norows}}
{{#body}}
    <div class="local-aicharts-chart">{{{body}}}</div>
{{/body}}
{{#runagain}}
    {{#canmanage}}
        <button type="button" class="btn btn-secondary mt-auto align-self-start" data-action="runnow" data-id="{{id}}" {{#queued}}disabled{{/queued}}>
            <i class="icon fa fa-play" aria-hidden="true"></i>{{runlabel}}
        </button>
    {{/canmanage}}
{{/runagain}}
