{{!
    @template local_aicharts/kind_choice

    The card label of one chart kind radio: title with icon, one-line description and an example.

    Context variables required for this template:
    * icon - Font Awesome icon class.
    * title - Name of the kind.
    * description - What every run does.
    * example - A one-line example.

    Example context (json):
    {
        "icon": "fa-chart-column",
        "title": "One-shot",
        "description": "Every run replaces the data.",
        "example": "Example: enrolments per course this month, redrawn from scratch on each run."
    }
}}
<span class="local-aicharts-kind-title"><i class="icon fa {{icon}}" aria-hidden="true"></i>{{title}}</span>
<span class="d-block">{{description}}</span>
<span class="d-block text-muted mt-2">{{example}}</span>
