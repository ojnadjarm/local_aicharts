{{!
    @template local_aicharts/wizard_steps

    The progress strip of the wizard: a numbered circle per step, completed steps as links.

    Context variables required for this template:
    * steps - The steps, each with number, name, done, current and url.

    Example context (json):
    {
        "steps": [
            {"number": 1, "name": "Kind", "done": true, "current": false, "url": "/local/aicharts/edit.php?w=abc&step=1"},
            {"number": 2, "name": "Data", "done": false, "current": true, "url": ""},
            {"number": 3, "name": "Chart", "done": false, "current": false, "url": ""}
        ]
    }
}}
<ol class="local-aicharts-steps" aria-label="{{#str}}wizardsteps, local_aicharts{{/str}}">
    {{#steps}}
        <li{{#done}} class="done"{{/done}}{{#current}} aria-current="step"{{/current}}>
            <span class="num">{{#done}}<i class="icon fa fa-check m-0" aria-hidden="true"></i>{{/done}}{{^done}}{{number}}{{/done}}</span>
            {{#done}}<a href="{{url}}" class="d-none d-sm-inline">{{name}}</a>{{/done}}
            {{#current}}<span>{{name}}</span>{{/current}}
            {{^done}}{{^current}}<span class="d-none d-sm-inline">{{name}}</span>{{/current}}{{/done}}
        </li>
    {{/steps}}
</ol>
