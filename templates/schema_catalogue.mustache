{{!
    @template local_aicharts/schema_catalogue

    The tables the assistant is told about, one line each with its key columns.

    Context variables required for this template:
    * tables - The catalogued tables, each with placeholder and hint.
    * count - How many tables are catalogued.

    Example context (json):
    {
        "tables": [
            {"placeholder": "{user}", "hint": "id, username, firstname, lastname, email."},
            {"placeholder": "{course}", "hint": "id, shortname, fullname, visible."}
        ],
        "count": 2
    }
}}
<details class="local-aicharts-catalogue border rounded mb-3" open>
    <summary class="px-3 py-2 fw-medium">
        <i class="icon fa fa-database" aria-hidden="true"></i>{{#str}}catalogue, local_aicharts{{/str}}
        <span class="text-muted small">({{count}})</span>
    </summary>
    <dl class="px-3 pb-2 mb-0 small">
        {{#tables}}
            <dt class="font-monospace fw-medium mt-1">{{placeholder}}</dt>
            <dd class="mb-0 text-muted">{{hint}}</dd>
        {{/tables}}
    </dl>
</details>
