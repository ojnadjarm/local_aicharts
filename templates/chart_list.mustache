{{!
    @template local_aicharts/chart_list

    The saved charts as one table; nothing is queried.

    Context variables required for this template:
    * rows - One entry per chart with id, name, dataname, icon, iconlabel, menu, scheduled, historyurl,
      mode, lastrun, numrows and state.

    Example context (json):
    {
        "rows": [
            {
                "id": 1,
                "name": "Enrolments per course",
                "dataname": "enrolments per course",
                "icon": "fa-chart-column",
                "iconlabel": "Bar chart",
                "menu": "",
                "scheduled": false,
                "historyurl": "",
                "mode": "Live",
                "lastrun": "-",
                "numrows": "-",
                "state": "-"
            }
        ]
    }
}}
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th scope="col"><span class="visually-hidden">{{#str}}charttype, local_aicharts{{/str}}</span></th>
                <th scope="col">{{#str}}name{{/str}}</th>
                <th scope="col">{{#str}}listmode, local_aicharts{{/str}}</th>
                <th scope="col">{{#str}}lastrun, local_aicharts{{/str}}</th>
                <th scope="col" class="text-end">{{#str}}listrows, local_aicharts{{/str}}</th>
                <th scope="col">{{#str}}liststate, local_aicharts{{/str}}</th>
                <th scope="col"><span class="visually-hidden">{{#str}}actions{{/str}}</span></th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr data-region="aic-row" data-id="{{id}}" data-name="{{dataname}}">
                    <td>
                        <i class="icon fa {{icon}} m-0" aria-hidden="true"></i>
                        <span class="visually-hidden">{{iconlabel}}</span>
                    </td>
                    <td>
                        {{#scheduled}}<a href="{{historyurl}}">{{name}}</a>{{/scheduled}}
                        {{^scheduled}}{{name}}{{/scheduled}}
                    </td>
                    <td class="text-nowrap">{{mode}}</td>
                    <td class="text-nowrap">{{lastrun}}</td>
                    <td class="text-end">{{numrows}}</td>
                    <td class="text-nowrap">{{state}}</td>
                    <td>{{{menu}}}</td>
                </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
